# Copy to .env to override defaults.
#
# The debezium/app database credentials are set in mariadb/initdb/01-users.sql
# and debezium/application.properties, not here.

MARIADB_ROOT_PASSWORD=rootpw

# Swap the MariaDB version for a comparison run. Both of these are verified
# against the full pipeline.
#   mariadb:12.3   (default, current LTS)
#   mariadb:11.8   (previous LTS)
MARIADB_IMAGE=mariadb:12.3
