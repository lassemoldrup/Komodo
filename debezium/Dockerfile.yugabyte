# Debezium Server with YugabyteDB's logical-replication connector.
#
# Four constraints force this build:
#
#   1. The stock Debezium PostgreSQL connector does NOT work against
#      YugabyteDB: it calls pg_current_wal_lsn(), which YB has not
#      implemented (yugabyte-db#30243). Yugabyte's fork is required.
#
#   2. Yugabyte ships that fork only inside an amd64 Kafka Connect image.
#      The jars are pure Java and therefore arch-neutral, so we pull that
#      image purely as a build stage and lift the jars onto a multi-arch
#      Debezium Server base. The result runs natively on arm64.
#
#   3. The connector is built against Debezium 2.5.2, so the Server
#      distribution must be 2.5.2 — it is NOT compatible with the 3.6.1 server
#      the MariaDB and Oracle sides use. This pin is forced by Yugabyte, who
#      publish only dz.2.5.2.yb.* builds; watch quay.io/yugabyte/ybdb-debezium
#      for a dz.3.x.yb.* tag, which would collapse the stack to one version.
#
#   4. The connector is compiled for Java 17, but debezium/server:2.5.2.Final
#      ships a Java 11 JRE. Running it there dies with
#      UnsupportedClassVersionError (class file version 61.0).
#
# Note the 2.5.2 config path is /debezium/conf (3.x moved it to
# /debezium/config).

ARG YB_DBZ_TAG=dz.2.5.2.yb.2026.1

# Build stage: amd64 only, but we take nothing from it except .jar files.
FROM --platform=linux/amd64 quay.io/yugabyte/ybdb-debezium:${YB_DBZ_TAG} AS ybconn

# Build stage: the Debezium Server distribution (multi-arch).
FROM quay.io/debezium/server:2.5.2.Final AS dist

FROM eclipse-temurin:17-jre
COPY --from=dist /debezium /debezium

# The YB connector is a full fork of the Postgres connector: it ships its own
# io.debezium.connector.postgresql.* classes (205 of them, including
# PostgresConnectorConfig). Leaving the stock jar in place lets it shadow the
# fork, and validation then rejects plugin.name=yboutput with
# "must be one of decoderbufs, pgoutput".
RUN rm -f /debezium/lib/debezium-connector-postgres-*.jar

COPY --from=ybconn /kafka/connect/debezium-connector-postgres/yugabytedb-source-connector-*.jar /debezium/lib/
COPY --from=ybconn /kafka/connect/debezium-connector-postgres/jdbc-yugabytedb-*.jar /debezium/lib/
# The *-sources / *-tests jars ship alongside the real one; drop them.
RUN rm -f /debezium/lib/*-sources.jar /debezium/lib/*-tests.jar /debezium/lib/*-test-sources.jar

RUN mkdir -p /debezium/data && chmod -R 777 /debezium/data /debezium/conf
WORKDIR /debezium
CMD ["/debezium/run.sh"]
