# Settings marked [pin] already match the MariaDB 12.3 default; they are stated
# explicitly so the experiment does not silently change when a default moves.
# Everything else differs from stock. See "Database parameters" in the README.

[mariadb]
server_id                        = 1
log_basename                     = mariadb

# --- Text/session contract ------------------------------------------------
# These server defaults are repeated and verified on every workload
# connection by the client adapter. The binary collation makes canonical text
# equality independent of locale; UTC removes host-time-zone dependence; the
# SQL mode preserves declared CHAR width on reads.
character_set_server             = utf8mb4
collation_server                 = utf8mb4_bin
default_time_zone                = +00:00
sql_mode                         = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION,PAD_CHAR_TO_FULL_LENGTH

# --- Isolation -------------------------------------------------------------
# [pin] Textbook Snapshot Isolation: a transaction writing a row changed since
# its snapshot is ABORTED with ER_CHECKREAD (1020) rather than blocking, i.e.
# first-committer-wins. Write skew across disjoint rows remains permitted.
# Only applies at REPEATABLE READ, so that is pinned too.
innodb_snapshot_isolation        = ON
transaction_isolation            = REPEATABLE-READ

# --- Binary log ------------------------------------------------------------
log_bin                          = mariadb-bin
binlog_format                    = ROW          # [pin]

# [pin] The monitor needs the value each write produced and the version it
# overwrote. This is the one setting that must not be reduced.
binlog_row_image                 = FULL

# Column names/types in the table-map event. Emitted once per table per
# transaction, not per row, so the cost is negligible.
binlog_row_metadata              = FULL

# The client logs its own operations, so SQL text in the binlog is dead weight.
binlog_annotate_row_events       = OFF

log_slave_updates                = OFF          # [pin] no replicas here
max_binlog_size                  = 256M
expire_logs_days                 = 1

# --- Durability ------------------------------------------------------------
# Crash durability is irrelevant for a throwaway harness. Affects durability
# only, never isolation semantics.
innodb_flush_log_at_trx_commit   = 0
sync_binlog                      = 0            # [pin]

# --- Throughput ------------------------------------------------------------
innodb_buffer_pool_size          = 1G
innodb_log_file_size             = 256M
max_connections                  = 512
performance_schema               = OFF          # [pin]
skip_name_resolve                = ON           # [pin]
