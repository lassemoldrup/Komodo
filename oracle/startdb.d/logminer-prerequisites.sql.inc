set define on verify off echo off feedback on

CREATE USER c##blackbox_logminer IDENTIFIED BY "&logminer_password"
  DEFAULT TABLESPACE users CONTAINER=ALL;

GRANT CREATE SESSION, SET CONTAINER, SELECT ANY TRANSACTION, LOGMINING
  TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT_CATALOG_ROLE TO c##blackbox_logminer CONTAINER=ALL;
GRANT EXECUTE ON DBMS_LOGMNR TO c##blackbox_logminer CONTAINER=ALL;
GRANT EXECUTE ON DBMS_LOGMNR_D TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$DATABASE TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$LOG TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$LOG_HISTORY TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$LOGMNR_LOGS TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$LOGMNR_CONTENTS TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$LOGMNR_PARAMETERS TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$PARAMETER TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$LOGFILE TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$ARCHIVED_LOG TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$ARCHIVE_DEST_STATUS TO c##blackbox_logminer CONTAINER=ALL;
GRANT SELECT ON V_$TRANSACTION TO c##blackbox_logminer CONTAINER=ALL;
