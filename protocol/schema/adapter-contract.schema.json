{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/adapter-contract.schema.json",
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sql_type", "nullable", "canonical_type"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "sql_type": {
          "type": "string",
          "pattern": "^(?:INT|BIGINT|FLOAT|TIMESTAMP|DECIMAL\\([1-9][0-9]*,[0-9]+\\)|VARCHAR\\([1-9][0-9]*\\)|CHAR\\([1-9][0-9]*\\))$"
        },
        "nullable": { "type": "boolean" },
        "canonical_type": {
          "type": "string",
          "enum": [
            "i32",
            "i64",
            "fixed_decimal",
            "float32",
            "timestamp_utc",
            "utf8_varchar",
            "utf8_char"
          ]
        },
        "generated": { "const": "auto_increment" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key_columns", "value_columns", "columns"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/tableName" },
        "key_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" }
        },
        "value_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        }
      }
    },
    "resultSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_type",
        "procedure",
        "statement_id",
        "trace_statement_id",
        "trace_projection",
        "table",
        "classification",
        "result_shape",
        "empty_result",
        "semantics_ignored"
      ],
      "properties": {
        "transaction_type": { "$ref": "common.schema.json#/$defs/adapterName" },
        "procedure": { "$ref": "common.schema.json#/$defs/adapterName" },
        "statement_id": { "$ref": "common.schema.json#/$defs/adapterName" },
        "trace_statement_id": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/adapterName" },
            { "type": "null" }
          ]
        },
        "trace_projection": {
          "type": "string",
          "enum": ["full_row", "omitted"]
        },
        "table": { "$ref": "common.schema.json#/$defs/tableName" },
        "classification": {
          "type": "string",
          "enum": ["snapshot", "local", "omit"]
        },
        "result_shape": {
          "type": "string",
          "enum": ["exact_key_row", "returned_rows", "aggregate_scalar"]
        },
        "empty_result": {
          "type": "string",
          "enum": ["absent", "no_event", "not_applicable"]
        },
        "semantics_ignored": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["predicate", "ordering", "limit", "aggregate", "join", "locking"]
          }
        },
        "omission_reason": {
          "type": "string",
          "enum": ["locking_current_read", "aggregate_scalar"]
        }
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "kind"],
      "properties": {
        "table": { "$ref": "common.schema.json#/$defs/tableName" },
        "kind": {
          "type": "string",
          "enum": ["constant", "scale_multiplier", "sum_column", "configuration"]
        },
        "value": { "$ref": "common.schema.json#/$defs/uint64" },
        "multiplier": { "$ref": "common.schema.json#/$defs/positiveUint64" },
        "source_table": { "$ref": "common.schema.json#/$defs/tableName" },
        "source_column": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "configuration_name": { "$ref": "common.schema.json#/$defs/adapterName" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "parent_table",
        "child_table",
        "parent_key_columns",
        "child_parent_columns",
        "child_sequence_column",
        "expected_count_column",
        "first_sequence_value",
        "sequence_step",
        "minimum_count",
        "maximum_count"
      ],
      "properties": {
        "kind": { "const": "contiguous_child_sequence" },
        "parent_table": { "$ref": "common.schema.json#/$defs/tableName" },
        "child_table": { "$ref": "common.schema.json#/$defs/tableName" },
        "parent_key_columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" }
        },
        "child_parent_columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" }
        },
        "child_sequence_column": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "expected_count_column": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "first_sequence_value": { "type": "integer" },
        "sequence_step": { "type": "integer", "minimum": 1 },
        "minimum_count": { "$ref": "common.schema.json#/$defs/positiveUint64" },
        "maximum_count": { "$ref": "common.schema.json#/$defs/positiveUint64" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark",
    "canonical_schema",
    "runtime_capabilities",
    "declared_isolations",
    "transaction_types",
    "application_tables",
    "projection_policy",
    "tables",
    "result_sets",
    "loader"
  ],
  "properties": {
    "benchmark": { "$ref": "common.schema.json#/$defs/adapterName" },
    "canonical_schema": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
    "runtime_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_trace", "cdc_normalization", "bootstrap_scan"],
      "properties": {
        "client_trace": { "type": "boolean" },
        "cdc_normalization": { "type": "boolean" },
        "bootstrap_scan": { "type": "boolean" }
      }
    },
    "declared_isolations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["READ_COMMITTED", "REPEATABLE_READ"]
      }
    },
    "transaction_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/adapterName" }
    },
    "application_tables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/tableName" }
    },
    "projection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinary_rows",
        "predicate_semantics",
        "aggregate_scalars",
        "implicit_dml_reads",
        "locking_reads"
      ],
      "properties": {
        "ordinary_rows": { "const": "whole_row_points" },
        "predicate_semantics": { "const": "omitted" },
        "aggregate_scalars": { "const": "omitted_without_event" },
        "implicit_dml_reads": { "const": "omitted_without_event" },
        "locking_reads": { "const": "omitted_without_event" }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/table" }
    },
    "result_sets": {
      "type": "array",
      "items": { "$ref": "#/$defs/resultSet" }
    },
    "loader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_parameter", "cardinalities", "relationships"],
      "properties": {
        "scale_parameter": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["name", "minimum"],
          "properties": {
            "name": { "$ref": "common.schema.json#/$defs/adapterName" },
            "minimum": { "$ref": "common.schema.json#/$defs/positiveUint64" }
          }
        },
        "cardinalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/cardinality" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        }
      }
    }
  }
}
