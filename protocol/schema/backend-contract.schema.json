{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/backend-contract.schema.json",
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expected_value"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "expected_value": { "type": "string", "maxLength": 1024 }
      }
    },
    "factRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value_rule", "expected_value"],
          "properties": {
            "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
            "value_rule": { "const": "exact" },
            "expected_value": { "type": "string", "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "value_rule"],
          "properties": {
            "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
            "value_rule": {
              "type": "string",
              "enum": ["sha256", "canonical_identifier", "positive_integer", "record_only"]
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "accepted_database_types",
    "physical_namespace",
    "session_contract",
    "normalized_capabilities",
    "connector_contract",
    "attestation_fact_contract"
  ],
  "properties": {
    "backend": { "$ref": "common.schema.json#/$defs/adapterName" },
    "accepted_database_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/adapterName" }
    },
    "physical_namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["database", "schema", "search_path", "canonical_schema", "identifier_case"],
      "properties": {
        "database": { "$ref": "common.schema.json#/$defs/physicalIdentifier" },
        "schema": { "$ref": "common.schema.json#/$defs/physicalIdentifier" },
        "search_path": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "common.schema.json#/$defs/physicalIdentifier" }
          ]
        },
        "canonical_schema": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "identifier_case": { "type": "string", "enum": ["lower", "upper"] }
      }
    },
    "session_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_isolations",
        "configure_in_autocommit",
        "configuration_statements",
        "required_observations"
      ],
      "properties": {
        "declared_isolations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["READ_COMMITTED", "REPEATABLE_READ"]
          }
        },
        "configure_in_autocommit": { "const": true },
        "configuration_statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "required_observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "normalized_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_framing",
        "commit_order",
        "complete_final_writes",
        "marker_last",
        "connector_startup_schema_evidence",
        "char_read_semantics"
      ],
      "properties": {
        "transaction_framing": { "const": "contiguous_begin_rows_end" },
        "commit_order": { "const": "single_stream_completed_transaction_order" },
        "complete_final_writes": { "const": true },
        "marker_last": { "const": true },
        "connector_startup_schema_evidence": {
          "type": "string",
          "enum": ["required", "not_available"]
        },
        "char_read_semantics": { "const": "pad_to_declared_length" }
      }
    },
    "connector_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_class",
        "source_connector",
        "source_version",
        "envelope_profile",
        "transaction_metadata",
        "tasks",
        "redis_stream"
      ],
      "properties": {
        "connector_class": { "type": "string", "minLength": 1, "maxLength": 256 },
        "source_connector": { "$ref": "common.schema.json#/$defs/adapterName" },
        "source_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "envelope_profile": { "$ref": "common.schema.json#/$defs/adapterName" },
        "transaction_metadata": { "const": true },
        "tasks": { "const": 1 },
        "redis_stream": { "const": "cdc" }
      }
    },
    "attestation_fact_contract": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/factRule" }
    }
  }
}
