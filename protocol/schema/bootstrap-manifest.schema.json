{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/bootstrap-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "run_id",
    "table_row_counts",
    "canonical_state_digest"
  ],
  "properties": {
    "kind": { "const": "bootstrap_manifest" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "table_row_counts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table", "row_count"],
        "properties": {
          "table": { "$ref": "common.schema.json#/$defs/tableName" },
          "row_count": { "$ref": "common.schema.json#/$defs/uint64" }
        }
      }
    },
    "canonical_state_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
