{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positiveUint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveUint64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tableName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_$]*\\.[A-Za-z_][A-Za-z0-9_$]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "nonEmptyBase64": {
      "allOf": [
        { "$ref": "#/$defs/base64" },
        { "minLength": 4 }
      ]
    },
    "redisStreamId": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)-(?:0|[1-9][0-9]*)$"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 96
    },
    "correlationId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "session_id",
        "txn_id"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "txn_id": { "$ref": "#/$defs/positiveUint64" }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_seq",
        "key_bytes_base64",
        "value_state",
        "source"
      ],
      "properties": {
        "event_seq": { "$ref": "#/$defs/uint32" },
        "key_bytes_base64": { "$ref": "#/$defs/nonEmptyBase64" },
        "value_state": {
          "type": "string",
          "enum": ["present", "absent"]
        },
        "value_bytes_base64": { "$ref": "#/$defs/base64" },
        "source": {
          "type": "string",
          "enum": ["snapshot", "local"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "value_state": { "const": "present" } },
            "required": ["value_state"]
          },
          "then": { "required": ["value_bytes_base64"] }
        },
        {
          "if": {
            "properties": { "value_state": { "const": "absent" } },
            "required": ["value_state"]
          },
          "then": { "not": { "required": ["value_bytes_base64"] } }
        }
      ]
    }
  }
}
