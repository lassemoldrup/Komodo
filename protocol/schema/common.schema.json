{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/common.schema.json",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "positiveUint32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveUint64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "adapterName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "canonicalIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "physicalIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_$#]{0,127}$"
    },
    "tableName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "base64": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "nonEmptyBase64": {
      "allOf": [
        { "$ref": "#/$defs/base64" },
        { "minLength": 4 }
      ]
    },
    "redisStreamId": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)-(?:0|[1-9][0-9]*)$"
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "maxLength": 96
    },
    "failureCode": {
      "type": "string",
      "enum": [
        "CONFIG_INVALID",
        "BRANCH_CONTRACT_MISMATCH",
        "ISOLATION_MISMATCH",
        "SESSION_CONTRACT_MISMATCH",
        "UNSUPPORTED_TRANSACTION",
        "UNSUPPORTED_READ_SOURCE",
        "UNEXPECTED_TABLE",
        "DDL_OBSERVED",
        "EXTERNAL_WRITER_OBSERVED",
        "SCHEMA_ATTESTATION_MISSING",
        "SCHEMA_ATTESTATION_DUPLICATE",
        "SCHEMA_ATTESTATION_MALFORMED",
        "SCHEMA_ATTESTATION_MISMATCH",
        "SCHEMA_ATTESTATION_DRIFT",
        "BACKEND_FACT_MISMATCH",
        "CLIENT_RECORD_MALFORMED",
        "CLIENT_READ_COUNT_MISMATCH",
        "CLIENT_READ_DIGEST_MISMATCH",
        "CLIENT_DUPLICATE_CORRELATION",
        "LOGICAL_TRANSACTION_DUPLICATE",
        "ATTEMPT_DUPLICATE",
        "MULTIPLE_COMMITTED_ATTEMPTS",
        "SESSION_UNKNOWN",
        "SESSION_SEQUENCE_NON_INCREASING",
        "SESSION_ATTEMPT_PROGRESS_INVALID",
        "SESSION_DONE_MISSING",
        "SESSION_DONE_MISMATCH",
        "CLIENT_RECORD_AFTER_DONE",
        "COMMIT_OUTCOME_AMBIGUOUS",
        "MARKER_WRITE_FAILED",
        "REDIS_PUBLICATION_FAILED",
        "CDC_RECORD_MALFORMED",
        "CDC_BEGIN_MISSING",
        "CDC_END_MISSING",
        "CDC_TRANSACTION_ID_MISMATCH",
        "CDC_EVENT_ORDINAL_INVALID",
        "CDC_EVENT_COUNT_MISMATCH",
        "CDC_DUPLICATE_CONFLICT",
        "MARKER_MISSING",
        "MARKER_MULTIPLE",
        "MARKER_MALFORMED",
        "MARKER_NOT_LAST",
        "MARKER_DUPLICATE",
        "UNMARKED_APPLICATION_TRANSACTION",
        "CDC_APPLICATION_AFTER_END",
        "CDC_ORDER_INVALID",
        "CLIENT_HALF_MISSING",
        "CDC_HALF_MISSING",
        "CORRELATION_MISMATCH",
        "CANONICAL_ENCODING_FAILED",
        "PRIMARY_KEY_IMAGE_INCOMPLETE",
        "COMMIT_SEQUENCE_INVALID",
        "CHECKER_INPUT_REJECTED",
        "RUN_MANIFEST_MISSING",
        "RUN_MANIFEST_DUPLICATE",
        "RUN_ID_MISMATCH",
        "FENCE_MISSING",
        "FENCE_DUPLICATE",
        "FENCE_ORDER_INVALID",
        "BOOTSTRAP_MANIFEST_MISSING",
        "BOOTSTRAP_STATE_MISMATCH",
        "PHASE_ANCHOR_FAILED",
        "QUIESCENCE_UNPROVEN",
        "COMPONENT_RESTARTED",
        "RECONCILIATION_MISMATCH",
        "JOIN_BUFFER_LIMIT_EXCEEDED",
        "CHECKER_STATE_LIMIT_EXCEEDED",
        "RESOURCE_EXHAUSTED",
        "INTERNAL_ERROR"
      ]
    },
    "correlationId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "session_id",
        "txn_id"
      ],
      "properties": {
        "run_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/sessionId" },
        "txn_id": { "$ref": "#/$defs/positiveUint64" }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_seq",
        "key_bytes_base64",
        "value_state",
        "source"
      ],
      "properties": {
        "event_seq": { "$ref": "#/$defs/uint32" },
        "key_bytes_base64": { "$ref": "#/$defs/nonEmptyBase64" },
        "value_state": {
          "type": "string",
          "enum": ["present", "absent"]
        },
        "value_bytes_base64": { "$ref": "#/$defs/base64" },
        "source": {
          "type": "string",
          "enum": ["snapshot", "local"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "value_state": { "const": "present" } },
            "required": ["value_state"]
          },
          "then": { "required": ["value_bytes_base64"] }
        },
        {
          "if": {
            "properties": { "value_state": { "const": "absent" } },
            "required": ["value_state"]
          },
          "then": { "not": { "required": ["value_bytes_base64"] } }
        }
      ]
    }
  }
}
