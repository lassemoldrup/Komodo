{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/row-vector-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "required_vectors"],
  "properties": {
    "benchmark": { "$ref": "common.schema.json#/$defs/adapterName" },
    "required_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "table", "covers"],
        "properties": {
          "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
          "table": { "$ref": "common.schema.json#/$defs/tableName" },
          "covers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "representative_row",
                "i32_min_key",
                "i32_max_key",
                "i64_min_key",
                "i64_max_key",
                "composite_key",
                "fixed_decimal",
                "float32",
                "timestamp_utc",
                "char_padding",
                "strict_utf8",
                "sql_null",
                "empty_value",
                "generated_key"
              ]
            }
          }
        }
      }
    }
  }
}
