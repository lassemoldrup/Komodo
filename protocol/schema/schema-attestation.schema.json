{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/schema-attestation.schema.json",
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "logical_sql_type", "nullable"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "logical_sql_type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nullable": { "type": "boolean" },
        "generated": { "const": true }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_table_name", "primary_key_columns", "columns"],
      "properties": {
        "canonical_table_name": { "$ref": "common.schema.json#/$defs/tableName" },
        "primary_key_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" }
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/column" }
        }
      }
    },
    "backendFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "canonical_value"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/canonicalIdentifier" },
        "canonical_value": { "type": "string", "maxLength": 4096 }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "run_id",
    "phase",
    "backend",
    "backend_source_id",
    "tables",
    "backend_facts",
    "canonical_attestation_digest"
  ],
  "properties": {
    "kind": { "const": "schema_attestation" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "phase": { "type": "string", "enum": ["STARTUP", "FINAL"] },
    "backend": { "$ref": "common.schema.json#/$defs/adapterName" },
    "backend_source_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "tables": {
      "type": "array",
      "minItems": 3,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/table" }
    },
    "backend_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/backendFact" }
    },
    "canonical_attestation_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
