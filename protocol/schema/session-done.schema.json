{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://db-monitoring.local/schema/session-done.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "run_id",
    "session_id",
    "final_session_seq",
    "logical_transactions_started",
    "successful_transactions",
    "terminal_aborted_transactions",
    "physical_attempts_started",
    "definitively_aborted_attempts",
    "published_write_transactions",
    "ignored_successful_no_write_transactions",
    "retry_attempts",
    "ambiguous_attempts",
    "rolling_correlation_digest"
  ],
  "properties": {
    "kind": { "const": "session_done" },
    "run_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "common.schema.json#/$defs/sessionId" },
    "final_session_seq": { "$ref": "common.schema.json#/$defs/uint64" },
    "logical_transactions_started": { "$ref": "common.schema.json#/$defs/uint64" },
    "successful_transactions": { "$ref": "common.schema.json#/$defs/uint64" },
    "terminal_aborted_transactions": { "$ref": "common.schema.json#/$defs/uint64" },
    "physical_attempts_started": { "$ref": "common.schema.json#/$defs/uint64" },
    "definitively_aborted_attempts": { "$ref": "common.schema.json#/$defs/uint64" },
    "published_write_transactions": { "$ref": "common.schema.json#/$defs/uint64" },
    "ignored_successful_no_write_transactions": { "$ref": "common.schema.json#/$defs/uint64" },
    "retry_attempts": { "$ref": "common.schema.json#/$defs/uint64" },
    "ambiguous_attempts": { "const": 0 },
    "rolling_correlation_digest": { "$ref": "common.schema.json#/$defs/sha256" }
  }
}
